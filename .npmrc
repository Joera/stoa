# pnpm 11.16 enables a default 24h minimum-release-age supply-chain check.
# The @earendil-works/* 1.0.0 packages (pi-durable, pi-ai, chord, telemetry)
# were published 2026-10-01, inside that window — which blocks `pnpm install`.
# These are first-party packages pinned by exact version in the committed
# frozen lockfile, so the age heuristic is disabled here.
minimum-release-age=0
